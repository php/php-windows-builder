{
  "components": [
    {
      "name": "Berkeley uuencode",
      "path": "ext/standard/uuencode.c",
      "license": "BSD-4-Clause-UC",
      "purl": "pkg:generic/berkeley-uuencode"
    },
    {
      "name": "Boost.Context assembly",
      "path": "Zend/asm",
      "license": "BSL-1.0",
      "purl": "pkg:generic/boost-context-assembly"
    },
    {
      "name": "crypt_blowfish",
      "version": "1.3",
      "path": "ext/standard/crypt_blowfish.c",
      "license": "bcrypt-Solar-Designer",
      "purl": "pkg:generic/crypt_blowfish@{version}"
    },
    {
      "name": "DynASM",
      "versionSource": {
        "path": "{path}/dynasm.lua",
        "pattern": "(?m)^\\s*version\\s*=\\s*\"(?<version>[^\"]+)\""
      },
      "path": "ext/opcache/jit/ir/dynasm",
      "license": "MIT",
      "purl": "pkg:generic/dynasm@{version}"
    },
    {
      "name": "FreeSec libcrypt",
      "path": "ext/standard/crypt_freesec.c",
      "license": "BSD-3-Clause",
      "purl": "pkg:generic/freesec-libcrypt"
    },
    {
      "name": "libarchive tar format_octal",
      "path": "ext/phar/tar.c",
      "license": "BSD-2-Clause",
      "purl": "pkg:generic/libarchive-format-octal"
    },
    {
      "name": "libavifinfo",
      "versionSource": {
        "path": "{path}/README.md",
        "pattern": "libavifinfo/\\+/(?<version>[0-9a-f]{40})"
      },
      "path": "ext/standard/libavifinfo",
      "license": "BSD-2-Clause",
      "purl": "pkg:generic/libavifinfo@{version}"
    },
    {
      "name": "libbcmath",
      "versionSource": {
        "path": ["{path}/README.md", "{path}/ChangeLog"],
        "pattern": "(?:bundled into PHP with version|version number now at)\\s+(?<version>[0-9]+(?:\\.[0-9]+)+)"
      },
      "path": "ext/bcmath/libbcmath",
      "license": "LGPL-2.1-only",
      "purl": "pkg:generic/libbcmath@{version}"
    },
    {
      "name": "libgd",
      "versionSource": {
        "path": "{path}/gd.h",
        "pattern": "(?m)^#define GD_VERSION_STRING \"(?<version>[^\"]+)\""
      },
      "path": "ext/gd/libgd",
      "license": "GD",
      "purl": "pkg:generic/libgd@{version}"
    },
    {
      "name": "libmagic",
      "versionSource": {
        "path": "{path}/magic.h",
        "pattern": "(?m)^#define MAGIC_VERSION\\s+(?<major>[0-9]+)(?<minor>[0-9]{2})\\b",
        "groups": ["major", "minor"]
      },
      "path": "ext/fileinfo/libmagic",
      "license": "BSD-2-Clause",
      "purl": "pkg:generic/libmagic@{version}"
    },
    {
      "name": "libmbfl",
      "versionSource": {
        "path": "{path}/mbfl/mbfilter.h",
        "pattern": "(?s)#define MBFL_VERSION_MAJOR\\s+(?<major>[0-9]+).*?#define MBFL_VERSION_MINOR\\s+(?<minor>[0-9]+).*?#define MBFL_VERSION_TEENY\\s+(?<teeny>[0-9]+)",
        "groups": ["major", "minor", "teeny"]
      },
      "path": "ext/mbstring/libmbfl",
      "license": "LGPL-2.1-only",
      "purl": "pkg:generic/libmbfl@{version}"
    },
    {
      "name": "libxmlrpc",
      "versionSource": {
        "path": "{path}/xmlrpc.h",
        "pattern": "#define XMLRPC_LIB_VERSION \"(?<version>[^\"]+)\""
      },
      "path": "ext/xmlrpc/libxmlrpc",
      "license": "BSD-3-Clause",
      "purl": "pkg:generic/xmlrpc-epi@{version}"
    },
    {
      "name": "libzip",
      "versionSource": {
        "path": "{path}/zipconf.h",
        "pattern": "(?m)^#define LIBZIP_VERSION \"(?<version>[^\"]+)\""
      },
      "path": "ext/zip/lib",
      "license": "BSD-3-Clause",
      "purl": "pkg:generic/libzip@{version}"
    },
    {
      "name": "libzip zip_dirent",
      "path": "ext/phar/zip.c",
      "license": "BSD-3-Clause",
      "purl": "pkg:generic/libzip-zip-dirent"
    },
    {
      "name": "MTRand",
      "versionSource": {
        "path": "{path}",
        "pattern": "Richard J\\. Wagner\\s+v(?<version>[0-9.]+)"
      },
      "path": "ext/random/engine_mt19937.c",
      "license": "BSD-3-Clause",
      "purl": "pkg:generic/mtrand@{version}"
    },
    {
      "name": "OpenLDAP ucgendat",
      "path": "ext/mbstring/ucgendat/ucgendat.php",
      "license": "OLDAP-2.8 AND MIT",
      "purl": "pkg:generic/openldap-ucgendat"
    },
    {
      "name": "Oniguruma",
      "versionSource": {
        "path": ["{path}/src/oniguruma.h", "{path}/oniguruma.h"],
        "pattern": "(?s)#define ONIGURUMA_VERSION_MAJOR\\s+(?<major>[0-9]+).*?#define ONIGURUMA_VERSION_MINOR\\s+(?<minor>[0-9]+).*?#define ONIGURUMA_VERSION_TEENY\\s+(?<teeny>[0-9]+)",
        "groups": ["major", "minor", "teeny"]
      },
      "path": "ext/mbstring/oniguruma",
      "license": "BSD-2-Clause",
      "purl": "pkg:generic/oniguruma@{version}"
    },
    {
      "name": "pcrelib",
      "versionSource": {
        "path": "{path}/pcre.h",
        "pattern": "(?s)#define PCRE_MAJOR\\s+(?<major>[0-9]+).*?#define PCRE_MINOR\\s+(?<minor>[0-9]+)",
        "groups": ["major", "minor"]
      },
      "path": "ext/pcre/pcrelib",
      "license": "BSD-3-Clause",
      "purl": "pkg:generic/pcre@{version}"
    },
    {
      "name": "pcre2lib",
      "versionSource": {
        "path": "{path}/pcre2.h",
        "pattern": "(?s)#define PCRE2_MAJOR\\s+(?<major>[0-9]+).*?#define PCRE2_MINOR\\s+(?<minor>[0-9]+)",
        "groups": ["major", "minor"]
      },
      "path": "ext/pcre/pcre2lib",
      "license": "BSD-3-Clause WITH PCRE2-exception",
      "purl": "pkg:generic/pcre2@{version}"
    },
    {
      "name": "SQLite",
      "versionSource": {
        "path": "{path}/sqlite3.h",
        "pattern": "(?m)^#define SQLITE_VERSION\\s+\"(?<version>[^\"]+)\""
      },
      "path": "ext/sqlite3/libsqlite",
      "license": "blessing",
      "purl": "pkg:generic/sqlite@{version}"
    },
    {
      "name": "snprintf",
      "path": "main/snprintf.c",
      "license": "ISC AND Apache-1.0",
      "purl": "pkg:generic/snprintf"
    },
    {
      "name": "strlcat",
      "path": "main/strlcat.c",
      "license": "BSD-3-Clause",
      "purl": "pkg:generic/strlcat"
    },
    {
      "name": "strlcpy",
      "path": "main/strlcpy.c",
      "license": "BSD-3-Clause",
      "purl": "pkg:generic/strlcpy"
    },
    {
      "name": "strnatcmp",
      "path": "ext/standard/strnatcmp.c",
      "license": "Zlib",
      "purl": "pkg:generic/strnatcmp"
    },
    {
      "name": "Tcl scanf implementation",
      "versionSource": {
        "path": "{path}",
        "pattern": "Original code is from TCL(?<version>[0-9.]+)"
      },
      "path": "ext/standard/scanf.c",
      "license": "TCL",
      "purl": "pkg:generic/tcl-scanf@{version}"
    },
    {
      "name": "timelib",
      "versionSource": {
        "path": "{path}/timelib.h",
        "pattern": "(?m)^#define TIMELIB_ASCII_VERSION \"(?<version>[^\"]+)\""
      },
      "path": "ext/date/lib",
      "license": "MIT",
      "purl": "pkg:generic/timelib@{version}"
    },
    {
      "name": "XKCP SHA-3",
      "path": "ext/hash/sha3",
      "license": "CC0-1.0 AND Brian-Gladman-3-Clause",
      "purl": "pkg:generic/xkcp-sha3"
    },
    {
      "name": "xxHash",
      "versionSource": {
        "path": "{path}/xxhash.h",
        "pattern": "(?s)#define XXH_VERSION_MAJOR\\s+(?<major>[0-9]+).*?#define XXH_VERSION_MINOR\\s+(?<minor>[0-9]+).*?#define XXH_VERSION_RELEASE\\s+(?<release>[0-9]+)",
        "groups": ["major", "minor", "release"]
      },
      "path": "ext/hash/xxhash",
      "license": "BSD-2-Clause",
      "purl": "pkg:generic/xxhash@{version}"
    }
  ],
  "php": {
    "7.1": {
